  "env": {
    "LLMENV_ROOT": "/Users/mbennett/dev/bennettaur/llmenv",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(find:*)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-find-exec.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $(./random-file.sh notification-sound/need_user_input)"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $(./random-file.sh notification-sound/need_user_input)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/notification-sound/probe_notify.mp3"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "agents": {
    "enabled": true,
    "paths": [
      "~/.claude/agents"
    ]
  },
  "skills": {
    "enabled": true,
    "paths": [
      "~/.claude/skills"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "sentience@memory-marketplace": true,
    "code-review-team-core@bennettaur-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "bennettaur-marketplace": {
      "source": {
        "source": "github",
        "repo": "bennettaur/llmenv"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.atlassian.com"
      ]
    },
    "allowUnixSockets": [
      "-- used by nx Daemon --",
      "/private/tmp/claude/**"
    ]
  },
  "theme": "dark",
  "tui": "fullscreen"
}
