  "env": {
    "LLMENV_ROOT": "/Users/mbennett/dev/bennettaur/llmenv",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-git-hooks.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $(./random-file.sh notification-sound/need_user_input)"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $(./random-file.sh notification-sound/need_user_input)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-review-team-core@bennettaur-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "bennettaur-marketplace": {
      "source": {
        "source": "github",
        "repo": "bennettaur/llmenv"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.atlassian.com"
      ]
    },
    "allowUnixSockets": [
      "-- used by nx Daemon --",
      "/private/tmp/claude/**"
    ]
  },
  "theme": "dark",
  "tui": "fullscreen",
  "autoCompactEnabled": false,
  "teammateMode": "tmux",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "yarvis"
  ],
  "outputStyle": "Plain and Direct"
}
